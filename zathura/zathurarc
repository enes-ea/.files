set scroll-step 50
set adjust-open "height"

set pages-per-row 2
set first-page-column 1:1:3

set font "Monospace 18"
set synctex true
set selection-clipboard clipboard

# theme

set default-fg                "#f2f4f8"
set default-bg                "#161616"

set completion-bg             "#161616"
set completion-fg             "#b6b8bb"
set completion-highlight-bg   "#353535"
set completion-highlight-fg   "#f2f4f8"
set completion-group-bg       "#161616"
set completion-group-fg       "#b6b8bb"

set statusbar-fg              "#f2f4f8"
set statusbar-bg              "#161616"
set inputbar-fg               "#f2f4f8"
set inputbar-bg               "#161616"

set notification-bg           "#161616"
set notification-fg           "#f2f4f8"
set notification-error-bg     "#ee5396"
set notification-error-fg     "#f2f4f8"
set notification-warning-bg   "#08bdba"
set notification-warning-fg   "#353535"

set recolor                   "false"
set recolor-lightcolor        "#161616"
set recolor-darkcolor         "#f2f4f8"

set index-fg                  "#f2f4f8"
set index-bg                  "#161616"
set index-active-fg           "#f2f4f8"
set index-active-bg           "#353535"

set render-loading            true
set render-loading-bg         "#f2f4f8"
set render-loading-fg         "#161616"

set highlight-color           "#08bdba"
set highlight-fg              "#f2f4f8"
set highlight-active-color    "#25be6a"
