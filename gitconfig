# vim: ft=gitconfig

[user]
    name = Enes Emre Aydogan
    email = enes@aydogan.io
    signingKey = E2F0AA32BE0C869C
    useConfigOnly = true

[include]
    path = ~/.config/delta/tokyonight.gitconfig
    path = ~/.files/gitconfig-local

[core]
    editor = nvim
    pager = delta
    autocrlf = input
    safecrlf = true
    quotePath = false

[init]
    defaultBranch = main

[commit]
    gpgSign = true
    verbose = true

[tag]
    gpgSign = true

[pretty]
    lg  = "tformat:%C(#7aa2f7)%h%Creset%C(auto)%d%Creset %<(50,trunc)%s %C(#565f89)(%cr)%Creset"
    lgw = "tformat:%C(#7aa2f7)%h%Creset%C(auto)%d%Creset %<(45,trunc)%s %C(#565f89)(%cr)%Creset %C(#73daca)<%an>%Creset"

[alias]
    lg      = log --graph --date-order --pretty=lg
    lgw     = log --graph --date-order --pretty=lgw
    lgb     = lg --branches
    lgr     = lg --remotes
    lgt     = lg --tags
    lga     = lg --all
    st      = status -sb
    br      = branch -vv
    unstage = restore --staged
    amend   = commit --amend --no-edit
    undo    = reset --soft HEAD~1
    last    = log -1 --stat

[log]
    graphColors = "#7aa2f7,#9ece6a,#ff9e64,#bb9af7,#73daca,#ff007c,#e0af68,#7dcfff"

[color "decorate"]
    HEAD         = "bold #bb9af7"
    branch       = "bold #9ece6a"
    remoteBranch = "bold #f7768e"
    tag          = "bold #e0af68"
    stash        = "bold #bb9af7"
    grafted      = "bold #565f89"

[color "branch"]
    current  = "bold #9ece6a"
    local    = "#9ece6a"
    remote   = "#f7768e"
    upstream = "bold #7dcfff"
    plain    = "#c0caf5"

[color "status"]
    header       = "#7aa2f7"
    branch       = "bold #7aa2f7"
    added        = "#9ece6a"
    changed      = "#e0af68"
    untracked    = "#f7768e"
    unmerged     = "bold #f7768e"
    localBranch  = "bold #9ece6a"
    remoteBranch = "#f7768e"

[column]
    ui = auto

[branch]
    sort = -committerdate

[diff]
    algorithm = histogram
    colorMoved = default
    mnemonicPrefix = true

[merge]
    conflictStyle = zdiff3

[fetch]
    prune = true
    writeCommitGraph = true

[push]
    autoSetupRemote = true
    followTags = true

[pull]
    rebase = true

[rebase]
    autoSquash = true
    autoStash = true
    updateRefs = true

[rerere]
    enabled = true

[help]
    autocorrect = prompt

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true
    dark = true
    line-numbers = true
    features = tokyonight-night
    side-by-side = true
    hyperlinks = true
    tabs = 2
    line-numbers-left-format = "{nm:>3} "
    line-numbers-right-format = "{np:>3} "
