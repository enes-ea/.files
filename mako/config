# Position & Size
anchor=top-right
width=400
height=200
margin=12
padding=12
border-radius=8

# Timeout & Icons
default-timeout=10000
icons=1
max-icon-size=48

# Behavior
max-visible=5
group-by=app-name
sort=-time
layer=overlay

# Font
font=JetBrainsMono Nerd Font 12

# Colors
background-color=#1a1b26
text-color=#c0caf5
border-color=#7dcfff
progress-color=over #292e42

[urgency=high]
border-color=#ff9e64
default-timeout=0
