# Position & Size
anchor=top-right
width=400
height=200
margin=12
padding=12
border-radius=8

# Timeout & Icons
default-timeout=10000
icons=1
max-icon-size=48

# Behavior
max-visible=5
group-by=app-name
sort=-time
layer=overlay

# Font
font=JetBrainsMono Nerd Font 12

# Colors
background-color=#161616
text-color=#f2f4f8
border-color=#33b1ff
progress-color=over #252525

[urgency=high]
border-color=#3ddbd9
default-timeout=0
