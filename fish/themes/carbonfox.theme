# Nightfox Color Palette
# Style: carbonfox
# Format: native fish theme (fish_config theme choose)
# Palette: https://github.com/EdenEast/nightfox.nvim

# Syntax highlighting
fish_color_normal         f2f4f8
fish_color_command        33b1ff
fish_color_param          be95ff
fish_color_keyword        ff7eb6
fish_color_quote          08bdba
fish_color_redirection    f2f4f8
fish_color_end            3ddbd9
fish_color_operator       25be6a
fish_color_escape         ff7eb6
fish_color_error          ee5396
fish_color_comment        6e6f70
fish_color_autosuggestion 7b7c7e

# Selection and search
fish_color_selection      --background=2a2a2a
fish_color_search_match   --background=525253

# Prompt decorations
fish_color_cwd            78a9ff
fish_color_cwd_root       ee5396
fish_color_user           25be6a
fish_color_host           33b1ff
fish_color_host_remote    08bdba
fish_color_history_current --bold
fish_color_valid_path     --underline

# Completion pager
fish_pager_color_progress    6e6f70
fish_pager_color_prefix      33b1ff
fish_pager_color_completion  f2f4f8
fish_pager_color_description 7b7c7e
fish_pager_color_selected_background --background=2a2a2a
