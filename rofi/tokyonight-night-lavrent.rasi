/**
 * Tokyo Night theme
 * Color palette copied from https://github.com/folke/tokyonight.nvim
 */

* {
    base: #1a1b26;
    surface0: #292e42;
    overlay0: #565f89;
    text: #c0caf5;

    mauve: #bb9af7;
    red: #f7768e;
    peach: #ff9e64;
    green: #9ece6a;
    blue: #7aa2f7;
    lavender: #9d7cd8;

    background-color: @base;
}

window {
    width: 1000;
    height: 100%;

    location: north west;
    anchor: north west;

    border: 0;
    border-radius: 0;
}

mainbox {
    spacing: 0;
    children: [inputbar, message, listview];
}

inputbar {
    color: @text;
    padding: 6 10;
    background-color: @base;
}

message {
    padding: 6;
    background-color: @overlay0;
}

listview {
    padding: 2;
    border-radius: 0;
    border: 0;
    background-color: @base;
    dynamic: true;
    scrollbar: false;
}

textbox {
    text-color: @text;
    background-color: inherit;
}

error-message {
    border: 20 20 20 20;
}

entry, prompt, case-indicator {
    text-color: inherit;
}

prompt {
    margin: 0 6 0 0;
}

element {
    padding: 2 8;
    border-radius: 3;
    background-color: @surface0;
    text-color: #ffffff;
}

element.selected.normal {
    background-color: @blue;
    text-color: #ffffff;
}

element.selected.normal element-text,
element.selected.normal element-icon {
    text-color: inherit;
}

element-text, element-icon {
    size: 12;
    margin: 0 4 0 0;
    background-color: inherit;
    text-color: inherit;
}

element-icon {
    size: 32;
}

element.normal.active, element.alternate.active {
    background-color: @peach;
}

element.selected.active {
    background-color: @green;
}

element.normal.urgent, element.alternate.urgent {
    background-color: @red;
}

element.selected.urgent {
    background-color: @mauve;
}
