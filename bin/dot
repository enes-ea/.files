#!/usr/bin/env bash
set -euo pipefail

ROOT="$HOME/.files"
CONFIG="$HOME/.config"
LINKS="$ROOT/links.json"

jq -c '.[]' "$LINKS" | while read -r entry; do
  src=$(jq -r '.src' <<<"$entry")
  dst=$(jq -r '.dst' <<<"$entry")
  root=$(jq -r '.root // "config"' <<<"$entry")

  target="$ROOT/$src"
  [[ "$root" == "home" ]] && link="$HOME/$dst" || link="$CONFIG/$dst"

  # Resolve link directory to detect if a parent symlink (e.g. ~/.config → ~/.files)
  # would make us write inside $ROOT, causing a recursive self-link.
  link_dir="$(dirname "$link")"
  resolved_link_dir="$(realpath "$link_dir" 2>/dev/null || echo "")"
  if [[ -n "$resolved_link_dir" ]]; then
    resolved_link="$resolved_link_dir/$(basename "$link")"
    if [[ "$resolved_link" == "$target" || "$resolved_link" == "$target"/* ]]; then
      printf '  \e[31mERROR:\e[0m %s would create a recursive symlink (%s → %s). Skipping.\n' "$src" "$resolved_link" "$target"
      continue
    fi
  fi

  [[ -e "$link" || -L "$link" ]] && rm -rf "$link"
  mkdir -p "$link_dir"
  ln -s "$target" "$link"
  printf '  %s \e[2m→\e[22m %s\n' "$src" "$link"
done

# Link per-machine profile overrides (selected by hostname, or DOT_PROFILE)
PROFILE="${DOT_PROFILE:-$(uname -n)}"

for pdir in "$ROOT"/*/profiles; do
  [[ -d "$pdir" ]] || continue
  app="$(basename "$(dirname "$pdir")")"
  src="$pdir/$PROFILE.conf"
  [[ -f "$src" ]] || src="$pdir/default.conf"
  [[ -f "$src" ]] || continue
  link="$ROOT/$app/machine.local.conf"
  rm -f "$link"
  ln -s "$src" "$link"
  printf '  %s \e[2m→\e[22m %s\n' "${src#"$ROOT"/}" "$link"
done
