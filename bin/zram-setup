#!/usr/bin/env bash
# ============================================================
#  zram-setup — configure zram (compressed RAM swap)
#
#  Usage:
#    zram-setup              interactive
#    zram-setup --yes        unattended (no prompts)
#    zram-setup --dry-run    show what WOULD happen, change nothing
#    zram-setup --tune       also write /etc/sysctl.d/99-zram.conf
#    zram-setup --help       this message
#
#  What it does:
#    1. installs the 'zram-generator' package (official repo)
#    2. writes /etc/systemd/zram-generator.conf (backup kept if present)
#    3. applies it WITHOUT a reboot (reset device + restart units)
#    4. verifies with zramctl / swapon
#
#  Notes:
#    * zram swap is RAM, it does NOT survive reboot and it CANNOT be
#      used for hibernation. Keep a disk/partition swap if you hibernate.
#    * safe to re-run: it is idempotent and only rewrites when needed.
#
#  Idempotent counterpart for a fresh machine: see ZRAM.md
# ============================================================
set -euo pipefail

CONF=/etc/systemd/zram-generator.conf
SYSCTL=/etc/sysctl.d/99-zram.conf
GENERATOR=/usr/lib/systemd/system-generators/zram-generator

DRY=0; YES=0; TUNE=0
for arg in "$@"; do
    case "$arg" in
        --dry-run) DRY=1 ;;
        --yes)     YES=1 ;;
        --tune)    TUNE=1 ;;
        -h|--help) sed -n '3,23p' "$0" | sed 's/^#\s\?//'; exit 0 ;;
        *) echo "unknown option: $arg" >&2; exit 1 ;;
    esac
done

# ---------- output helpers ----------
c0=$'\e[0m'; cB=$'\e[1;34m'; cG=$'\e[1;32m'; cY=$'\e[1;33m'
[[ -t 1 ]] || c0= cB= cG= cY=
header() { printf '\n%s\n' "${cB}── $1 ──${c0}"; }
ok()     { printf '%s\n' "${cG}✓ $1${c0}"; }
warn()   { printf '%s\n' "${cY}⚠ $1${c0}"; }
info()   { printf '  %s\n' "$1"; }
have()   { command -v "$1" >/dev/null 2>&1; }
confirm() { [[ -n "${1:-}" ]] && printf '%s [y/N] ' "$1"; read -r a; [[ "$a" == y || "$a" == Y ]]; }
run()    { if (( DRY )); then printf '  (dry-run) %s\n' "$*"; return 0; fi; "$@"; }
srun()   { if (( EUID == 0 )); then run "$@"; else run sudo "$@"; fi; }

# config that we want on disk
conf_body() {
    cat <<'EOF'
# Managed by zram-setup (dotfiles). See ZRAM.md.
[zram0]
zram-size = ram / 2
compression-algorithm = zstd
EOF
}

sysctl_body() {
    cat <<'EOF'
# zram swap tuning. CachyOS kernels already default to these values;
# this file makes them explicit and portable to other kernels.
vm.swappiness = 100
vm.page-cluster = 0
EOF
}

# ---------- pre-flight ----------
[[ -e /var/lib/pacman/db.lck ]] && { warn "pacman is running — aborting."; exit 1; }

header "Pre-flight"
info "RAM:       $(awk '/MemTotal/{printf "%.1f GiB", $2/1048576}' /proc/meminfo)"
info "zram size: $(( $(awk '/MemTotal/{print $2}' /proc/meminfo) / 2 / 1048576 )) GiB (ram / 2)"

# non-zram swap already active?
disk_swap=$(swapon --noheadings --show=NAME 2>/dev/null | grep -v 'zram' || true)
if [[ -n "$disk_swap" ]]; then
    warn "disk swap is active: $(echo "$disk_swap" | tr '\n' ' ')"
    info "zram gets priority 100, so it is preferred; disk swap still used as fallback."
else
    info "no disk swap active — good for a pure zram setup."
    warn "without disk swap, hibernation is NOT possible on this machine."
fi
grep -Eq '^[^#].*[[:space:]]swap[[:space:]]' /etc/fstab 2>/dev/null \
    && warn "an /etc/fstab swap entry exists — review it if you want zram-only."

# ---------- 1. package ----------
header "Package"
if pacman -Qq zram-generator >/dev/null 2>&1; then
    ok "zram-generator already installed ($(pacman -Q zram-generator | awk '{print $2}'))"
else
    info "zram-generator is missing"
    if (( DRY )); then
        info "would: pacman -S --needed zram-generator"
    elif (( YES )) || confirm "Install zram-generator now?"; then
        srun pacman -S --needed --noconfirm zram-generator && ok "installed" \
            || { warn "install failed"; exit 1; }
    else
        warn "skipped — cannot continue without the package"; exit 1
    fi
fi

# ---------- 2. configuration ----------
header "Configuration"
new_conf=$(conf_body)
if [[ -f "$CONF" ]] && diff -q <(printf '%s\n' "$new_conf") "$CONF" >/dev/null 2>&1; then
    ok "$CONF already up to date"
else
    if [[ -f "$CONF" ]]; then
        info "existing $CONF differs:"
        printf '%s\n' "$new_conf" | diff -u "$CONF" - | sed 's/^/    /' || true
    else
        info "$CONF does not exist yet"
    fi
    if (( DRY )); then
        info "would write $CONF"
    elif (( YES )) || confirm "Write $CONF?"; then
        if [[ -f "$CONF" ]]; then
            srun cp -a "$CONF" "$CONF.bak"
            info "backup: $CONF.bak"
        fi
        printf '%s\n' "$new_conf" | srun tee "$CONF" >/dev/null
        ok "wrote $CONF"
    else
        warn "skipped config write"
    fi
fi

if (( TUNE )); then
    new_sysctl=$(sysctl_body)
    if [[ -f "$SYSCTL" ]] && diff -q <(printf '%s\n' "$new_sysctl") "$SYSCTL" >/dev/null 2>&1; then
        ok "$SYSCTL already up to date"
    elif (( DRY )); then
        info "would write $SYSCTL"
    else
        printf '%s\n' "$new_sysctl" | srun tee "$SYSCTL" >/dev/null
        ok "wrote $SYSCTL"
    fi
fi

# ---------- 3. apply without reboot ----------
header "Apply"
# union of configured devices and devices that currently exist
mapfile -t devs < <({
    grep -oE '^\[[[:space:]]*zram[0-9]+' "$CONF" 2>/dev/null | tr -d '[] '
    ls /sys/block 2>/dev/null | grep -E '^zram[0-9]+$' || true
} | sort -u)

if (( ${#devs[@]} == 0 )); then
    warn "no zram devices configured or present — nothing to apply"
else
    for dev in "${devs[@]}"; do
        if swapon --noheadings --show=NAME 2>/dev/null | grep -qx "/dev/$dev"; then
            if srun swapoff "/dev/$dev"; then (( DRY )) || info "swapped off /dev/$dev"
            else warn "could not swapoff /dev/$dev (busy?) — continuing"; fi
        fi
        if [[ -e "/sys/block/$dev" ]]; then
            if srun "$GENERATOR" --reset-device "$dev"; then (( DRY )) || info "reset $dev"
            else warn "could not reset $dev — continuing"; fi
        fi
    done
    srun systemctl daemon-reload
    for dev in "${devs[@]}"; do
        if (( DRY )); then
            info "would: systemctl restart systemd-zram-setup@$dev.service"
        elif srun systemctl restart "systemd-zram-setup@$dev.service"; then
            ok "started systemd-zram-setup@$dev.service"
        else
            warn "could not start $dev — a reboot will apply it cleanly"
        fi
    done
fi

# ---------- 4. verify ----------
header "Result"
if (( DRY )); then
    info "(dry-run) nothing was changed"
else
    if have zramctl; then zramctl | sed 's/^/    /'; fi
    swapon --show | sed 's/^/    /' || true
    if swapon --noheadings --show=NAME 2>/dev/null | grep -q zram; then
        ok "zram swap is active"
    else
        warn "zram swap is not active yet — reboot, then re-check with: zramctl && swapon --show"
    fi
fi
